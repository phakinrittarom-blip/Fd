local TeleTab = Window:CreateTab("วาร์ป & Fling", 4483362458)
TeleTab:CreateSection("ระบบ Fling & Teleport")

local targetPlayerName = ""
local flingEnabled = false

local function getOtherPlayers()
    local tbl = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(tbl, p.Name) end
    end
    if #tbl == 0 then table.insert(tbl, "ไม่มีผู้เล่นอื่น") end
    return tbl
end

local PlayerDropdown = TeleTab:CreateDropdown({
   Name = "เลือกผู้เล่นเป้าหมาย",
   Options = getOtherPlayers(),
   CurrentOption = getOtherPlayers()[1],
   Flag = "TargetDropdown",
   Callback = function(Option)
      targetPlayerName = type(Option) == "table" and Option[1] or Option
   end,
})

TeleTab:CreateButton({
   Name = "รีเฟรชรายชื่อผู้เล่น",
   Callback = function() PlayerDropdown:Set(getOtherPlayers()) end,
})

TeleTab:CreateButton({
   Name = "วาร์ปไปหาผู้เล่นที่เลือก",
   Callback = function()
      local target = Players:FindFirstChild(targetPlayerName)
      if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
          if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
              LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame
          end
      end
   end,
})

-- ระบบ Fling ชนกระเด็นจริง (เป้าหมายปลิว ตัวเรากลับตำแหน่งเดิม)
TeleTab:CreateToggle({
   Name = "ชนกระเด็น (Super Fling)",
   CurrentValue = false,
   Flag = "FlingTargetToggle",
   Callback = function(Value)
      flingEnabled = Value
      if Value then
          task.spawn(function()
              local myChar = LocalPlayer.Character
              if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
              local myHRP = myChar.HumanoidRootPart
              local oldCFrame = myHRP.CFrame

              while flingEnabled do
                  RunService.Heartbeat:Wait()
                  local target = Players:FindFirstChild(targetPlayerName)
                  if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                      local tHRP = target.Character.HumanoidRootPart
                      
                      -- อัปเดตความเร็วเชิงมุมและเชิงเส้นระดับสูงเพื่อส่งแรงชน
                      myHRP.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
                      myHRP.AssemblyLinearVelocity = Vector3.new(999999, 999999, 999999)
                      
                      -- สลับวาร์ปชนเป้าหมายในระยะเผาขนแบบสุ่มทิศทาง
                      myHRP.CFrame = tHRP.CFrame * CFrame.new(math.random(-1, 1), math.random(-1, 1), math.random(-1, 1)) * CFrame.Angles(math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)), 0)
                  end
              end

              -- คืนค่าความเร็วปกติและกลับตำแหน่งเดิมทันทีที่ปิด
              myHRP.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
              myHRP.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
              myHRP.Velocity = Vector3.new(0, 0, 0)
              myHRP.RotVelocity = Vector3.new(0, 0, 0)
              myHRP.CFrame = oldCFrame
          end)
      end
   end,
})

