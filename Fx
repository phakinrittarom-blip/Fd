-- 🎯 4. แท็บระบบเล็งเป้า (Aimbot)
-- ==========================================
local AimTab = Window:CreateTab("ระบบเล็ง (Aimbot)", 4483362458)
AimTab:CreateSection("ตั้งค่า Aimbot")

local aimbotEnabled = false
local fovRadius = 150

local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Radius = fovRadius
fovCircle.Color = Color3.fromRGB(255, 0, 0)
fovCircle.Thickness = 1.5
fovCircle.Filled = false
fovCircle.Transparency = 1

local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = fovRadius

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") and plr.Character:FindFirstChildOfClass("Humanoid").Health > 0 then
            local targetPart = plr.Character.Head
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)

            if onScreen then
                local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude

                if distance < shortestDistance then
                    shortestDistance = distance
                    closestPlayer = targetPart
                end
            end
        end
    end
    return closestPlayer
end

AimTab:CreateToggle({
   Name = "เปิดใช้งาน Aimbot (Camera Lock)",
   CurrentValue = false,
   Flag = "AimbotToggle",
   Callback = function(Value) aimbotEnabled = Value end,
})

AimTab:CreateToggle({
   Name = "แสดงวงกลมเล็ง (Show FOV Circle)",
   CurrentValue = false,
   Flag = "FOVVIsibleToggle",
   Callback = function(Value) fovCircle.Visible = Value end,
})

AimTab:CreateSlider({
   Name = "ขนาดวงกลมเล็ง (FOV Radius)",
   Range = {50, 500},
   Increment = 10,
   Suffix = "px",
   CurrentValue = 150,
   Flag = "FOVSlider",
   Callback = function(Value)
      fovRadius = Value
      fovCircle.Radius = Value
   end,
})

RunService.RenderStepped:Connect(function()
    fovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if aimbotEnabled then
        local target = getClosestPlayer()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end
end)

