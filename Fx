-- 🔪 1. แท็บ MM2 (Murder Mystery 2 Hub)
-- ==========================================
local MM2Tab = Window:CreateTab("MM2 Mode", 4483362458)
MM2Tab:CreateSection("ระบบช่วยเล่น Murder Mystery 2")

local autoGun = false
local autoCoin = false
local roleEsp = false

local function getMM2Roles()
    local murderer, sheriff = nil, nil
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            if p.Backpack:FindFirstChild("Knife") or p.Character:FindFirstChild("Knife") then
                murderer = p
            elseif p.Backpack:FindFirstChild("Gun") or p.Character:FindFirstChild("Gun") then
                sheriff = p
            end
        end
    end
    return murderer, sheriff
end

-- 1. ดูบทบาทผู้เล่น (Role ESP)
MM2Tab:CreateToggle({
   Name = "ดูบทบาทผู้เล่น (Show Roles ESP)",
   CurrentValue = false,
   Flag = "MM2RoleESP",
   Callback = function(Value)
      roleEsp = Value
      if Value then
          task.spawn(function()
              while roleEsp do
                  local m, s = getMM2Roles()
                  for _, p in pairs(Players:GetPlayers()) do
                      if p.Character and p ~= LocalPlayer then
                          local hl = p.Character:FindFirstChild("MM2_Role_HL") or Instance.new("Highlight")
                          hl.Name = "MM2_Role_HL"
                          hl.Parent = p.Character
                          if p == m then
                              hl.FillColor = Color3.fromRGB(255, 0, 0)
                          elseif p == s then
                              hl.FillColor = Color3.fromRGB(0, 100, 255)
                          else
                              hl.FillColor = Color3.fromRGB(0, 255, 0)
                          end
                          hl.Enabled = roleEsp
                      end
                  end
                  task.wait(1)
              end
          end)
      end
   end,
})

-- 2. กดปุ่มเล็งเป้าใส่ฆาตกร (Snap Aim Murderer)
MM2Tab:CreateButton({
   Name = "🎯 กดเล็งเป้าใส่ฆาตกร (Snap Aim Murderer)",
   Callback = function()
      local murderer, _ = getMM2Roles()
      if murderer and murderer.Character and murderer.Character:FindFirstChild("Head") then
          local head = murderer.Character.Head
